# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...
LANGSMITH_API_KEY=lsv2_...

# Optional overrides:
# WORKSPACE_ID=00000000-0000-0000-0000-000000000000  # LangSmith workspace (tenant); default = the one tied to the API key
# PROJECT_NAME=dashboard-agent                        # LangSmith tracing project for agent runs
# DASHBOARD_MODEL=claude-sonnet-4-5-20250929
# DASHBOARD_PROMPT=dashboard-agent-system             # Prompt Hub name to pull the system prompt from

# Synthetic data mode — make the demo work for ANY topic (default is the bundled
# humanitarian corpus). A fast LLM stands in for the data tools; topic + gaps live
# in the `dashboard-agent-data` prompt in Prompt Hub. Seed it: python scripts/seed_data_prompt.py
# DASHBOARD_DATASET=synthetic
# DASHBOARD_DATA_MODEL=anthropic:claude-haiku-4-5-20251001   # any init_chat_model id; e.g. xai:grok-4.1 (needs langchain-xai + XAI_API_KEY)
# DASHBOARD_DATA_PROMPT=dashboard-agent-data

# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# These are the Agent Server (backend) env vars. The React frontend's VITE_* vars
# (VITE_LG_URL / VITE_LG_API_KEY) are set in the host (e.g. Vercel), not here.

# --- Required ---
# EITHER a provider key (below) OR the LangSmith gateway. The gateway is what this
# deployment uses: set a WORKSPACE-scoped LangSmith key with `gateway:invoke` and point
# every model at it. An org-scoped key does not work - the gateway answers
# 403 org_scoped_key_requires_workspace.
#
# LANGSMITH_GATEWAY_API_KEY=lsv2_...
# Route models through the gateway on Anthropic's NATIVE path, not /v1:
# ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic
# ANTHROPIC_API_KEY=<the same workspace-scoped gateway token>
# Use the native path, NOT `langsmith:anthropic/...` over /v1/chat/completions.
# NOT because /v1 cannot carry the narration - it can, verified on the wire, streaming
# and not: content comes back populated alongside tool_calls. It is that Claude does not
# VOLUNTEER a preamble when its tools are presented in OpenAI function shape, where the
# convention is content=null beside tool_calls. Ask for one explicitly and you get it on
# either path; the agent does not ask. Matched runs, same prompt, same model: 5 of 10
# tool-calling messages carried text natively, 0 of 10 over /v1.
# Does NOT cover voice: the Live API is a WebSocket and its token endpoint is not
# allow-listed by the gateway, so GEMINI_API_KEY stays required (see voice.py).
# AGENT_MODEL=langsmith:anthropic/claude-sonnet-5
# ...and the same `langsmith:anthropic/...` form for JUDGE_MODEL, GOAL_MODEL,
# SETUP_MODEL and SIMULATED_MODEL, or those four keep calling the provider directly.
#
# Note the gateway centralises WHERE THE KEY LIVES, not who pays: with BYOK it calls the
# provider with the workspace's own secret, so a workspace pointing at an account with
# no credit returns the provider's billing error exactly as a direct call would.

LANGSMITH_API_KEY=lsv2_...            # LangSmith key for tracing + Context Hub
# ...plus ONE model provider. Anthropic is the default and needs nothing else:
ANTHROPIC_API_KEY=sk-ant-...          # Anthropic key (or a gateway key; see "AI gateway" below)
# On a non-Anthropic deployment, leave the line above unset and set AGENT_MODEL
# plus that provider's key instead — see "Non-Anthropic model providers" below.
# Run `uv run python scripts/preflight.py` to check whichever combination you chose.

# --- Web search ---
# Required for the `web_search` tool. Without it the tool returns an error rather
# than falling back to invented results, so the agent cannot cite fake sources.
TAVILY_API_KEY=tvly-...

# --- LangSmith routing (optional) ---
# WORKSPACE_ID=00000000-0000-0000-0000-000000000000  # LangSmith workspace (tenant); default = the one tied to the API key
# PROJECT_NAME=custom-demo                            # LangSmith tracing project for agent runs (was `dashboard-agent`)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # override for EU/self-hosted
# LS_CROSS_WORKSPACE_KEY=lsv2_...      # org-scoped key: cross-workspace hub push/pull + per-run trace routing
#                                      # (falls back to LANGSMITH_API_KEY).

# --- Model overrides (optional) ---
# AGENT_MODEL=claude-sonnet-5          # main agent model
# JUDGE_MODEL=anthropic:claude-haiku-4-5-20251001  # demo-eval judge; pin it and
#                                      # leave it alone, including while swapping the agent
#                                      # model, or an experiment comparison moves two things
# GOAL_MODEL=anthropic:claude-haiku-4-5-20251001   # grades a /goal against the transcript
# GOAL_MAX_ITERATIONS=2                # revisions a turn may be sent back for before the
#                                      # goal stands. Each one is a whole extra agent loop
# SETUP_MODEL=anthropic:claude-haiku-4-5-20251001  # assistant-setup agent
# SIMULATED_MODEL=anthropic:claude-haiku-4-5-20251001  # simulated tools (draft_email etc.)
# MODEL_TEMPERATURE=                   # EMPTY = send no temperature at all. Needed for
#                                      # reasoning-tuned models that reject any value but
#                                      # their own default (they fail at invoke time, so the
#                                      # error surfaces mid-run and looks like a broken judge).
#                                      # Unset = each call site's own default. A number forces it.
#
# DEPRECATED SPELLINGS, still read as a fallback so an existing .env or deployment
# secret keeps working. Set the new name above instead; the old one wins only when the
# new one is unset (or, for the temperature, entirely absent - an empty new value is a
# value). "Dashboard agent" is what this used to be; it reads files, runs code in a VM,
# writes artifacts, talks to MCP servers, drafts email and searches the web now, and
# building a dashboard is one capability among several.
#   DASHBOARD_MODEL               -> AGENT_MODEL
#   DASHBOARD_JUDGE_MODEL         -> JUDGE_MODEL
#   DASHBOARD_GOAL_MODEL          -> GOAL_MODEL
#   DASHBOARD_GOAL_MAX_ITERATIONS -> GOAL_MAX_ITERATIONS
#   DASHBOARD_SETUP_MODEL         -> SETUP_MODEL
#   DASHBOARD_SIMULATED_MODEL     -> SIMULATED_MODEL
#   DASHBOARD_VOICE_MODEL         -> VOICE_MODEL
#   DASHBOARD_TEMPERATURE         -> MODEL_TEMPERATURE
# DASHBOARD_DATA_MODEL is REMOVED, not deprecated: it was a third-level fallback for the
# synthetic data source, which no longer exists. Use SIMULATED_MODEL.
#
# The `DA_*` runtime knobs went the same way, and for the same reason - the `DA` was
# "Dashboard Agent". Same rule: new name first, old name still read.
#   DA_SANDBOX            -> SANDBOX_ENABLED      (see "Runtime knobs" below)
#   DA_DYNAMIC_SUBAGENTS  -> DYNAMIC_SUBAGENTS
#   DA_FILES_ROOT         -> SANDBOX_FILES_ROOT
#   DA_MCP_TOOLS_TTL      -> MCP_TOOLS_TTL
#   DA_MCP_TIMEOUT        -> MCP_TIMEOUT
#
# PROJECT_NAME's DEFAULT moved for the same reason, and it has NO fallback: with
# PROJECT_NAME unset, runs traced into a project called `dashboard-agent` and now trace
# into `custom-demo`. Set PROJECT_NAME=dashboard-agent above to keep appending to an
# existing project of that name.

# --- Runtime knobs (optional) ---
# SANDBOX_ENABLED=1          # 0 kills the code-execution VM. The agent then has no data
#                            # source at all and will say so rather than invent one.
#                            # EXACTLY "0" disables it - "false" and "no" leave it ON.
# DYNAMIC_SUBAGENTS=0        # 1 lets `task()` dispatch subagents from QuickJS code.
#                            # Opposite polarity: on only when exactly "1".
# SANDBOX_FILES_ROOT=/workspace  # narrows what the SPA's file browser can read out of
#                            # the assistant's VM. `.env*` and non-allowlisted
#                            # extensions are excluded regardless.

# --- A non-Anthropic model through the gateway (optional) ---
# Anything the gateway lists is reachable with the `langsmith:` provider and no new
# dependency: it is ChatOpenAI pointed at gateway.smith.langchain.com/v1. NVIDIA
# Nemotron on Fireworks, verified with a three-turn tool loop (read_file, then
# push_widget, then a text answer):
#
#   AGENT_MODEL=langsmith:fireworks/accounts/fireworks/models/nemotron-3-ultra-nvfp4
#   LANGSMITH_GATEWAY_API_KEY=<workspace-scoped key with gateway:invoke>
#
# `nemotron-lightning-3p5-30b-a3b` is the cheaper, faster sibling and also calls tools
# correctly. `curl -H "Authorization: Bearer $LANGSMITH_API_KEY" \
# https://gateway.smith.langchain.com/v1/models` lists what the workspace can reach
# (BYOK: the workspace's own Fireworks secret pays).
#
# Two things change versus Claude, neither of them broken:
#  - No preamble before tool calls, for the OpenAI-function-shape reason described
#    above, so the chat shows the tool chip with no "I'll pull that up" line.
#  - Nemotron is a reasoning model and its content arrives as `reasoning` + `text`
#    blocks. `contentToText` in the SPA keeps only the text blocks, which is what we
#    want, so the reasoning is dropped rather than rendered.

# --- Non-Anthropic model providers (optional) ---
# AGENT_MODEL takes any init_chat_model id, so `provider:model` picks the provider.
# A bare id (e.g. "claude-sonnet-5") stays Anthropic, which is what every existing
# assistant uses. Azure OpenAI, including a corporate API-management gateway in front
# of it, is the common case:
#
# Google Gemini needs nothing new if you already set GEMINI_API_KEY for voice mode:
# that name is accepted as an alias for GOOGLE_API_KEY, so
#   AGENT_MODEL=google_genai:gemini-3.8-flash
# works with the key that is already there.
#
# AGENT_MODEL=azure_openai:<your-deployment-name>
# AZURE_OPENAI_ENDPOINT=https://<host>/<base-path>   # everything BEFORE /openai/deployments/
# AZURE_OPENAI_API_KEY=...                           # sent as the `api-key` header
# OPENAI_API_VERSION=2024-12-01-preview
#
# Read the endpoint off a working curl: for
#   https://HOST/BASE/openai/deployments/DEPLOYMENT/chat/completions?api-version=VERSION
# the three values are AZURE_OPENAI_ENDPOINT=https://HOST/BASE, DEPLOYMENT and VERSION.
# The /openai/deployments/... suffix is added by the client — including it 404s.

# --- Assistant setup agent (optional) ---
# BRANDFETCH_API_KEY=...               # Brandfetch Brand API — accurate brand colors (falls back to LLM guess). ~100 free pulls.
# LOGODEV_TOKEN=pk_...                 # Logo.dev publishable key for customer logos (has a built-in default)


# --- AI gateway (optional) ---
# Route model calls through a proxy instead of calling Anthropic directly. When set,
# ANTHROPIC_API_KEY above is the gateway key. Used by the deployed agent to reach the model.
# ANTHROPIC_BASE_URL=https://<gateway-host>/anthropic
# ANTHROPIC_CUSTOM_HEADERS=X-Api-Key:<...>

# --- Voice mode (optional) ---
# Turns on the mic button for assistants whose builder flag has it enabled. The browser
# talks to Gemini Live directly using a short-lived token this key mints (POST
# /voice/token), so the key stays server-side and no audio transits the deployment.
# Get one from https://aistudio.google.com/apikey
# GEMINI_API_KEY=<...>
# The Live model. Default is the current low-latency audio-to-audio one; the 2.5
# native-audio model also works (see config.voice_model for the tradeoff).
# VOICE_MODEL=gemini-3.1-flash-live-preview

# --- Remote MCP servers (optional) ---
# Which servers an assistant connects to is per-assistant config (Settings -> MCP
# servers), not env: these only tune how the deployment talks to them. Tools are
# discovered per run and cached, on top of the client-side tools/list cache that
# honours the server's own TTL hint.
# MCP_TOOLS_TTL=120           # seconds to reuse a discovered tool list
# MCP_TIMEOUT=20              # seconds before an unreachable server is given up on
#
# The bundled demo server (mcp_demo_server/, run via scripts/run_mcp_server.sh):
# FIELDLINK_PORT=8765
# FIELDLINK_PATH=/mcp
# FIELDLINK_CACHE_TTL=300     # the TTL hint it advertises to clients

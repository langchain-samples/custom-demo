{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": ["."],
  "python_version": "3.13",
  "graphs": {
    "dashboard_agent": "./custom_demo/graph.py:graph",
    "assistant_setup": "./custom_demo/setup_graph.py:graph"
  },
  "env": ".env",
  "auth": {
    "path": "./custom_demo/auth.py:auth"
  },
  "http": {
    "app": "./custom_demo/webapp.py:app",
    "enable_custom_route_auth": true,
    "cors": {
      "allow_origins": ["*"],
      "allow_methods": ["*"],
      "allow_headers": ["*"]
    }
  }
}
